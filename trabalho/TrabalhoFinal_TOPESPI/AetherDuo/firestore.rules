rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regra simples recomendada para o Projeto de Tópicos Especiais (3º ano Ensino Médio)
    // Permite leitura e escrita para qualquer usuário autenticado no app:
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
